<Project Sdk="Cosmos.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PegasiOS</RootNamespace>
    <CosmosKernelClass>PegasiOS.Kernel</CosmosKernelClass>
    <!-- The PinePhone is an ARM64 device: a bare `dotnet build` targets it; an explicit -r still wins. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="$(PegasiCosmosVersion)" />
    <PackageReference Include="Cosmos.Kernel.System" Version="$(PegasiCosmosVersion)" />
  </ItemGroup>

  <!-- The home screen's wallpaper, which Shell/Wallpaper.cs reads under this name. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\51-pegasi.png" LogicalName="PegasiOS/51-pegasi.png" />
  </ItemGroup>

  <!-- The UI kit the shell and its controls are built on: Aura.UI, which has a
       repository of its own. It is built from a clone of that repository next
       to this one. It is not published as a package, and the Aura.UI on
       nuget.org is another library, so nothing is restored in its place.
       A clone somewhere else: -p:AuraUIProject=<path to Aura.UI.csproj>. -->
  <PropertyGroup>
    <AuraUIProject Condition="'$(AuraUIProject)' == ''">$(MSBuildThisFileDirectory)../../../Aura.UI/src/Aura.UI/Aura.UI.csproj</AuraUIProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AuraUIProject)" />
  </ItemGroup>
  <Target Name="CheckAuraUIClone" BeforeTargets="Restore;CollectPackageReferences;BeforeBuild" Condition="!Exists('$(AuraUIProject)')">
    <Error Text="Aura.UI was not found at $(AuraUIProject). Clone the Aura.UI repository next to PegasiOS, or pass -p:AuraUIProject=&lt;path to Aura.UI.csproj&gt;." />
  </Target>

</Project>
