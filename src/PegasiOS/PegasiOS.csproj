<Project Sdk="Cosmos.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PegasiOS</RootNamespace>
    <CosmosKernelClass>PegasiOS.Kernel</CosmosKernelClass>
    <!-- The PinePhone is an ARM64 device: a bare `dotnet build` targets it; an explicit -r still wins. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="$(PegasiCosmosVersion)" />
    <PackageReference Include="Cosmos.Kernel.System" Version="$(PegasiCosmosVersion)" />
  </ItemGroup>

</Project>
